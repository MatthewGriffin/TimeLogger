{
  "name": "timelogger-app",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "test:backend": "npm --prefix src-node test",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "check:version": "node scripts/check-version.mjs",
    "check": "npm run check:version && npm run build && npm run test:backend && npm run check:rust",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.102.8",
    "@tauri-apps/plugin-http": "^2.6.0",
    "axios": "^1.20.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.41",
    "vue-router": "^4.5.0",
    "vuetify": "^4.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11"
  }
}
