{
  "name": "timelogger-app",
  "private": true,
  "version": "0.7.39",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "test:backend": "npm --prefix src-node test",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "check:version": "node scripts/check-version.mjs",
    "check": "npm run check:version && npm run build && npm run test:backend && npm run check:rust",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.104.5",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-http": "^2.8.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "axios": "^1.20.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vuetify": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13"
  },
  "overrides": {
    "follow-redirects": "^1.16.1",
    "source-map-js": "^1.2.2"
  }
}
