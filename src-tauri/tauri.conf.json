{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TimeLogger",
  "version": "0.8.2-beta.1",
  "identifier": "com.timelogger.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "TimeLogger",
        "width": 1700,
        "height": 1280,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:5173 ws://localhost:5173; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "assetProtocol": {
        "enable": true
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "nsis",
    "copyright": "Copyright (c) 2026 Matthew Griffin",
    "shortDescription": "Tempo time logging helper app",
    "longDescription": "Logs working time and submits it to Tempo, with Jira, Outlook, OneNote and GitHub integrations.",
    "resources": [
      "../src-node"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDQjdCNjZFMjRDMzMyNEYKUldSUE1zTWticmEzM0xQQUQ1dGtwUDhtdzNXTGJvZTh1b0NRZXIyWXhkYXA4MTJMMlkxYlBhaXgK",
      "endpoints": [
        "https://github.com/MatthewGriffin/TimeLogger/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
